# Copy this file to .env and fill in real values. Never commit .env.

# IMAP — from cPanel's "Connect Devices" / "Set Up Mail Client" page for jobs@example.com
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=jobs@example.com
IMAP_PASSWORD=

# Your Anthropic API key (separate from your Claude.ai subscription)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# The FULL, dated CV — used only for scoring accuracy, never shown to anyone.
# Keep this separate from whatever dateless version you actually submit.
CV_PATH=cv_scoring_full.txt

# Optional overrides — defaults are fine to leave as-is
# IMAP_FOLDER=INBOX
# STATE_DB=job_pipeline.sqlite
# REPORT_DIR=reports
