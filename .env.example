# Copy this file to .env and fill in real values. Never commit .env.

# JobHunter IMAP credentials
IMAP_SERVER=imap.example.com
IMAP_USER=jobs@example.com
IMAP_PASS=
IMAP_FOLDER=INBOX

# Anthropic API key
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# The FULL, dated CV — used only for scoring accuracy, never shown to anyone.
CV_PATH=cv_scoring_full.txt
